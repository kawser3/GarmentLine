{
  "name": "garmentline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GarmentLine — sample approval and production issue tracker for a knit garment factory, on SELISE Blocks.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode dev",
    "build:prod": "tsc -b && vite build --mode prod",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "cert": "bash scripts/dev-cert.sh",
    "schemas": "node scripts/01-define-schemas.mjs",
    "seed": "node scripts/04-seed.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "docker:build": "docker build -t garmentline:local ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  },
  "engines": { "node": ">=22" }
}
